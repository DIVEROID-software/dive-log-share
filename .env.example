# Base URL của API. Copy file này thành .env và chỉnh theo môi trường.
# Lưu ý: biến VITE_* được nhúng vào bundle lúc BUILD (không phải runtime).
VITE_API_BASE_URL=https://supabase.diveroid.shop

# Base path khi build (mặc định '/dive-log-share/' cho GitHub Pages, '/' cho Docker root).
# VITE_BASE_PATH=/
